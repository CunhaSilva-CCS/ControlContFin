{
  "expo": {
    "name": "ControlContFin",
    "slug": "controlcontfin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cunhasilva.controlcontfin",
      "appleTeamId": "797H5PK46F"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cunhasilva.controlcontfin"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-task-manager",
      "expo-background-task",
      "expo-dev-client",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o ControlContFin use o Face ID para desbloquear o app."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permitir que o ControlContFin use o Face ID para proteger seus dados de acesso."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF6EF"
        }
      ]
    ]
  }
}
